# Security checklist: HTTPS-first upgrade + explicit plaintext fallback.
# (Private-network and secure-DNS refusals are covered in basic.lethe.)
load http://example.com/
wait
assert-url-contains https://example.com
# https://httpforever.com does not answer TLS: the error page must offer
# exactly one explicit, labelled way to continue over plain http.
load http://httpforever.com/
wait 30000
assert-body-contains Continue to http://httpforever.com/ (not encrypted)
screenshot $TMPDIR/lethe-e2e-sec-01-https-first-error.png
click a.fallback
sleep 1500
wait 30000
assert-url-contains http://httpforever.com
assert-body-contains reliably insecure connection
screenshot $TMPDIR/lethe-e2e-sec-02-http-fallback.png
# The allow-list is per host and per session: a different host still upgrades.
load http://www.iana.org/
wait
assert-url-contains https://www.iana.org
# Tracker protection: from a first-party page, a third-party request to a
# listed analytics host must fail at the engine (blocked), while an
# unlisted third-party host still loads. Same probe, opposite outcomes.
load https://example.com/
wait
js window.__lethe={};fetch('https://www.google-analytics.com/collect?v=1',{mode:'no-cors'}).then(function(){window.__lethe.ga='loaded'},function(){window.__lethe.ga='blocked'});fetch('https://www.iana.org/',{mode:'no-cors'}).then(function(){window.__lethe.ok='loaded'},function(){window.__lethe.ok='blocked'});'sent'
wait-js 15000 window.__lethe.ga && window.__lethe.ok
assert-js window.__lethe.ga === 'blocked'
assert-js window.__lethe.ok === 'loaded'
# Oblivion window: isolated store (a cookie set in the normal window is not
# visible), https-only (plaintext refused outright, no fallback link), and
# closing it returns to the normal session with its state intact.
js document.cookie='lethe_e2e=normal; path=/; SameSite=Lax'; document.cookie
assert-js document.cookie.indexOf('lethe_e2e=normal') >= 0
oblivion https://example.com/
wait
assert-oblivion on
assert-js document.cookie.indexOf('lethe_e2e') < 0
load http://httpforever.com/
wait
assert-body-contains Oblivion windows are https-only
screenshot $TMPDIR/lethe-e2e-sec-03-oblivion-plaintext-refused.png
closetab
sleep 500
assert-oblivion off
assert-js document.cookie.indexOf('lethe_e2e=normal') >= 0
quit
