#include <windows.h>

#define LETHE_VERSION_MAJOR 1
#define LETHE_VERSION_MINOR 3
#define LETHE_VERSION_PATCH 4

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LETHE_VERSION_MAJOR,LETHE_VERSION_MINOR,LETHE_VERSION_PATCH,0
 PRODUCTVERSION LETHE_VERSION_MAJOR,LETHE_VERSION_MINOR,LETHE_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "ACOTech"
   VALUE "FileDescription", "Lethe Secure Browser"
   VALUE "FileVersion", "1.3.4"
   VALUE "InternalName", "lethe-win.exe"
   VALUE "OriginalFilename", "lethe-win.exe"
   VALUE "ProductName", "Lethe"
   VALUE "ProductVersion", "1.3.4"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
