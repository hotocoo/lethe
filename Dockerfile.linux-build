# Linux build/e2e image for the GTK shell (Ubuntu 24.04, WebKitGTK 4.1).
#   docker build -f Dockerfile.linux-build -t lethe-linux .
#   docker run --rm lethe-linux                      # unit tests
#   docker run --rm -e LETHE_WEBKIT_SANDBOX=0 lethe-linux \
#     xvfb-run -a ./build-linux/lethe --e2e-script tests/e2e/basic.lethe
# LETHE_WEBKIT_SANDBOX=0 is container-only: bubblewrap cannot create user
# namespaces inside an unprivileged container. On a real desktop the WebKit
# content sandbox stays ON.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake ninja-build pkg-config ca-certificates \
    libssl-dev zlib1g-dev libseccomp-dev libgtk-3-dev libwebkit2gtk-4.1-dev \
    xvfb dbus-x11 fonts-dejavu-core adwaita-icon-theme \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B build-linux -DCMAKE_BUILD_TYPE=Release -G Ninja \
 && cmake --build build-linux --parallel
CMD ["sh", "-c", "cd build-linux && ./lethe_tests"]
